rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── stock_items ──────────────────────────────────────────────────────────
    // Leitura pública (catálogo do BadStore)
    // Escrita APENAS via Admin SDK do BadTracking (regra false bloqueia client SDK)
    match /stock_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Cada usuário lê e escreve apenas seu próprio documento
    // Usado para: perfil (name, phone, photoUrl) e token FCM
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── orders ───────────────────────────────────────────────────────────────
    // Create: usuário autenticado, só pode criar pedido com seu próprio uid,
    //         status inicial obrigatoriamente 'draft', origem 'badstore'
    // Read:   só o dono do pedido
    // Update: cliente pode editar apenas customerNote/customerNoteAt no seu pedido
    // Delete: bloqueado para client SDK — só Admin SDK do BadTracking
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.origem == 'badstore'
        && request.resource.data.keys().hasAll(['customerName', 'customerContact', 'items', 'total']);

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Cliente só pode tocar em customerNote e customerNoteAt — nada mais
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['customerNote', 'customerNoteAt']);

      allow delete: if false;
    }
  }
}
